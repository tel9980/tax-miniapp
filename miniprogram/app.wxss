page {
  background: #f5f6f7;
  font-size: 28rpx;
  color: #1f2329;
  line-height: 1.6;
}

/* 卡片 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 20rpx;
  line-height: 1;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.tag.tax { background: #eef3ff; color: #2b6de8; }
.tag.type { background: #e8f7ef; color: #0f9d58; }
.tag.region { background: #f3f0ff; color: #7c4dff; }
.tag.area { background: #e6f7f4; color: #0d9488; }
.tag.column { background: #fff7e6; color: #d48806; }
.tag.st-ok { background: #e8f7ef; color: #0f9d58; }
.tag.st-soon { background: #fff7e6; color: #d48806; }
.tag.st-expired { background: #feeceb; color: #d4380d; }
.tag.st-unknown { background: #f0f1f3; color: #8a8f99; }
.tag.st-warn { background: #fff1e6; color: #d46b08; }

/* 空态 */
.empty {
  text-align: center;
  color: #8a8f99;
  padding: 120rpx 40rpx;
  font-size: 26rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  color: #2b6de8;
  padding: 24rpx;
  font-size: 26rpx;
}
