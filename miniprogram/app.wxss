/* app.wxss —— 全局样式，统一视觉规范 */
page {
  background: #f4f6f9;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #2c3e50;
}

/* ===== 通用卡片 ===== */
.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(26, 61, 92, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a3d5c;
  margin-bottom: 20rpx;
}

/* ===== 主色调 ===== */
.primary-color { color: #1a3d5c; }
.success-color { color: #27ae60; }
.warn-color { color: #e67e22; }
.danger-color { color: #e74c3c; }

/* ===== 数字高亮 ===== */
.num-big {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a3d5c;
}
.num-mid {
  font-size: 40rpx;
  font-weight: 600;
  color: #27ae60;
}

/* ===== 按钮 ===== */
.btn-primary {
  background: #1a3d5c;
  color: #ffffff;
  border-radius: 16rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}
.btn-primary:active { opacity: 0.85; }

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: #eef2f7;
  color: #1a3d5c;
  margin-right: 12rpx;
}
.tag-success {
  background: #e8f8ef;
  color: #27ae60;
}
.tag-warn {
  background: #fdf1e3;
  color: #e67e22;
}

/* ===== 分割线 ===== */
.divider {
  height: 2rpx;
  background: #eef1f5;
  margin: 24rpx 0;
}

/* ===== 表单行 ===== */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f2f4f7;
}
.form-label { font-size: 28rpx; color: #2c3e50; }
.form-input {
  text-align: right;
  font-size: 28rpx;
  color: #1a3d5c;
}