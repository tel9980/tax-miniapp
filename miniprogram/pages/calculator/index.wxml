<!-- pages/calculator/index.wxml —— 税率速查 -->
<view class="page">
  <view class="tabs">
    <view class="tab {{tab==='comprehensive'?'active':''}}" data-tab="comprehensive" bindtap="switchTab">综合所得</view>
    <view class="tab {{tab==='bonus'?'active':''}}" data-tab="bonus" bindtap="switchTab">年终奖</view>
    <view class="tab {{tab==='business'?'active':''}}" data-tab="business" bindtap="switchTab">个体经营</view>
  </view>

  <view class="table-card card">
    <view class="table-head">
      <text class="c1">级</text>
      <text class="c2">应纳税所得额(元)</text>
      <text class="c3">税率</text>
      <text class="c4">速算扣除数</text>
    </view>
    <block wx:if="{{tab==='comprehensive'}}">
      <view class="table-row" wx:for="{{comprehensive}}" wx:key="level">
        <text class="c1">{{item.level}}</text>
        <text class="c2">{{item.range}}</text>
        <text class="c3">{{item.rate}}</text>
        <text class="c4">{{item.quick}}</text>
      </view>
    </block>
    <block wx:elif="{{tab==='bonus'}}">
      <view class="table-row" wx:for="{{bonus}}" wx:key="level">
        <text class="c1">{{item.level}}</text>
        <text class="c2">{{item.range}}</text>
        <text class="c3">{{item.rate}}</text>
        <text class="c4">{{item.quick}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="table-row" wx:for="{{business}}" wx:key="level">
        <text class="c1">{{item.level}}</text>
        <text class="c2">{{item.range}}</text>
        <text class="c3">{{item.rate}}</text>
        <text class="c4">{{item.quick}}</text>
      </view>
    </block>
  </view>

  <view class="card note-card">
    <view class="card-title">📌 说明</view>
    <view class="note">综合所得/年终奖：按月均或年度金额对应税率。速算扣除数用于简化计算：税额 = 应纳税所得额×税率 − 速算扣除数。</view>
  </view>
</view>