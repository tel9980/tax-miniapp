/* 税率速查页面 */
.page { padding-bottom: 60rpx; }
.tabs { display: flex; background: #fff; padding: 16rpx 20rpx; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 16rpx 0; color: #5a6472; font-size: 28rpx; border-bottom: 4rpx solid transparent; }
.tab.active { color: #1a3d5c; font-weight: 600; border-bottom-color: #1a3d5c; }
.table-card { padding: 20rpx 24rpx; }
.table-head, .table-row { display: flex; padding: 16rpx 0; align-items: center; }
.table-head { color: #8a94a6; font-size: 24rpx; border-bottom: 2rpx solid #eef1f5; }
.table-row { font-size: 26rpx; border-bottom: 2rpx solid #f6f8fa; }
.c1 { width: 8%; }
.c2 { flex: 1; }
.c3 { width: 18%; }
.c4 { width: 22%; text-align: right; }
.note { font-size: 24rpx; color: #5a6472; line-height: 1.6; }