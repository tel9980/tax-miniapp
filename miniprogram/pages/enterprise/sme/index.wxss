/* 小微优惠页面 */
.page { padding-bottom: 60rpx; }
.calc-btn { margin-top: 30rpx; }
.result-row { display: flex; justify-content: space-between; align-items: center; padding: 16rpx 0; font-size: 28rpx; }
.result-row text:first-child { color: #5a6472; }
.note { margin-top: 16rpx; font-size: 24rpx; color: #8a94a6; }
.tip { margin-top: 16rpx; padding: 16rpx; background: #fdf1e3; border-radius: 12rpx; font-size: 24rpx; }
.tip.danger { background: #fdeaea; color: #c0392b; }
.disclaimer { text-align: center; color: #a0a8b5; font-size: 22rpx; margin-top: 30rpx; }