/* pages/index/index.wxss */
.page { padding-bottom: 60rpx; }

.hero {
  background: linear-gradient(135deg, #1a3d5c, #2a5f8f);
  padding: 50rpx 30rpx 40rpx;
  color: #fff;
}
.hero-title { font-size: 44rpx; font-weight: 700; }
.hero-sub { font-size: 26rpx; opacity: 0.85; margin: 12rpx 0 24rpx; }
.hero-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 40rpx;
  background: rgba(255,255,255,0.18);
  margin-right: 16rpx;
  font-size: 26rpx;
}
.hero-tag.active { background: #fff; color: #1a3d5c; font-weight: 600; }

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a3d5c;
  margin: 30rpx 32rpx 6rpx;
}

.menu-card {
  display: flex;
  align-items: center;
}
.menu-icon { font-size: 48rpx; margin-right: 20rpx; }
.menu-info { flex: 1; }
.menu-name { font-size: 30rpx; font-weight: 600; }
.menu-desc { font-size: 24rpx; color: #8a94a6; margin-top: 6rpx; }
.menu-arrow { color: #c0c8d4; font-size: 40rpx; }

.quick-calc { display: flex; align-items: center; }
.quick-icon { font-size: 48rpx; margin-right: 20rpx; }
.quick-info { flex: 1; }
.quick-name { font-size: 30rpx; font-weight: 600; }
.quick-desc { font-size: 24rpx; color: #8a94a6; margin-top: 6rpx; }
.btn-small { padding: 12rpx 30rpx; font-size: 26rpx; }

.history-card { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 28rpx; }

.disclaimer {
  text-align: center;
  color: #a0a8b5;
  font-size: 22rpx;
  margin-top: 40rpx;
}