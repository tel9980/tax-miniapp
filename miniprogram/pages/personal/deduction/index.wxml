<!-- pages/personal/deduction/index.wxml —— 专项附加扣除 -->
<view class="page">
  <view class="card">
    <view class="card-title">📋 专项附加扣除测算</view>

    <view class="form-row">
      <view class="form-label">子女教育数量（个）</view>
      <input class="form-input" type="number" data-field="childrenCount"
        value="{{form.childrenCount}}" bindinput="onInput" />
    </view>
    <view class="form-row">
      <view class="form-label">3岁以下婴幼儿（个）</view>
      <input class="form-input" type="number" data-field="infantCount"
        value="{{form.infantCount}}" bindinput="onInput" />
    </view>
    <view class="form-row">
      <view class="form-label">赡养老人</view>
      <switch data-field="elderly" checked="{{form.elderly}}" bindchange="onSwitch" />
    </view>
    <view class="form-row" wx:if="{{form.elderly}}">
      <view class="form-label">是否独生子女</view>
      <switch data-field="elderlyOnly" checked="{{form.elderlyOnly}}" bindchange="onSwitch" />
    </view>
    <view class="form-row">
      <view class="form-label">住房贷款利息</view>
      <switch data-field="housingLoan" checked="{{form.housingLoan}}" bindchange="onSwitch" />
    </view>
    <block wx:if="{{!form.housingLoan}}">
      <view class="form-row">
        <view class="form-label">住房租金城市</view>
        <picker range="{{rentTiers}}" range-key="city" bindchange="onRent">
          <view class="picker-val">
            {{form.housingRentTier>=0 ? rentTiers[form.housingRentTier].city : '不选（无房租扣除）'}}
          </view>
        </picker>
      </view>
    </block>
    <view class="form-row">
      <view class="form-label">学历继续教育</view>
      <switch data-field="continuingEdu" checked="{{form.continuingEdu}}" bindchange="onSwitch" />
    </view>
    <view class="form-row">
      <view class="form-label">职业资格继续教育</view>
      <switch data-field="continuingCert" checked="{{form.continuingCert}}" bindchange="onSwitch" />
    </view>
    <view class="form-row">
      <view class="form-label">大病医疗年自付（元）</view>
      <input class="form-input" type="digit" data-field="medicalAnnual"
        value="{{form.medicalAnnual}}" bindinput="onInput" />
    </view>

    <view class="btn-primary calc-btn" bindtap="onCalc">汇总测算</view>
  </view>

  <block wx:if="{{result}}">
    <view class="card">
      <view class="card-title">📊 扣除合计</view>
      <view class="result-row">
        <text>每月可扣除</text>
        <text class="num-big">{{result.monthly}} 元</text>
      </view>
      <view class="result-row">
        <text>全年可扣除</text>
        <text class="num-mid">{{result.annual}} 元</text>
      </view>
      <block wx:if="{{result.medicalAnnualDeduct>0}}">
        <view class="result-row">
          <text>其中大病医疗</text>
          <text>{{result.medicalAnnualDeduct}} 元</text>
        </view>
      </block>
      <view class="divider"></view>
      <view class="detail-title">明细</view>
      <view class="detail-row" wx:for="{{result.detail}}" wx:key="name">
        <text>{{item.name}}</text>
        <text>{{item.monthly}} 元/月</text>
      </view>
    </view>
  </block>

  <view class="disclaimer">房贷与房租二选一；大病医疗仅在年度汇算时申报</view>
</view>