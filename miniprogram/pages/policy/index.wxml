<!-- pages/policy/index.wxml —— 政策库 -->
<view class="page">
  <view class="filter">
    <view class="f-tag {{cat==='全部'?'active':''}}" data-cat="全部" bindtap="filterCat">全部</view>
    <view class="f-tag {{cat==='个人'?'active':''}}" data-cat="个人" bindtap="filterCat">个人</view>
    <view class="f-tag {{cat==='企业'?'active':''}}" data-cat="企业" bindtap="filterCat">企业</view>
  </view>

  <block wx:for="{{policies}}" wx:key="id">
    <view class="card" wx:if="{{cat==='全部'||cat===item.cat}}">
      <view class="p-head">
        <text class="tag">{{item.tag}}</text>
        <text class="p-title">{{item.title}}</text>
      </view>
      <view class="p-body">{{item.body}}</view>
    </view>
  </block>

  <view class="disclaimer">政策可能随文件调整，请以最新官方发布为准</view>
</view>