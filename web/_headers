/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://cdn.jsdelivr.net https://raw.githubusercontent.com https://cloudflareinsights.com; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# 页面本身不缓存（改版立即生效），政策数据由前端 fetch + localStorage 缓存
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/app.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=3600
  Content-Type: application/manifest+json; charset=utf-8

/sw.js
  Cache-Control: public, max-age=0, must-revalidate
